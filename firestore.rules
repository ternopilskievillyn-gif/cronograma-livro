rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // pessoa excluída pela administração não consegue recriar o perfil
    function notRemoved() {
      return !exists(/databases/$(database)/documents/removed/$(request.auth.uid));
    }

    // Administradores: só lista de ids. Todos os logados leem; ninguém altera pelo app
    // (para criar um admin, use o console do Firebase ou o CLI).
    match /admins/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Acesso removido: a própria pessoa e os admins leem; só admin escreve.
    match /removed/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin());
      allow write: if isAdmin();
    }

    // Perfis: todos os logados veem; cada um edita o seu; admin pode excluir.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && notRemoved();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Livros: todos veem e cadastram; quem cadastrou (ou admin) exclui.
    match /books/{bookId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid && notRemoved();
      allow update: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Progresso (dias concluídos): visível ao clube, editável só pelo dono; admin pode apagar.
    match /progress/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_.*') && notRemoved();
      allow delete: if signedIn() && (id.matches(request.auth.uid + '_.*') || isAdmin());
    }

    // Anotações das 3 perguntas: privadas. Admin só pode apagar (não lê).
    match /notes/{id} {
      allow read: if signedIn() && id.matches(request.auth.uid + '_.*');
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_.*') && notRemoved();
      allow delete: if signedIn() && (id.matches(request.auth.uid + '_.*') || isAdmin());
    }
  }
}
